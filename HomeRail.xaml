<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
        TextElement.Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
  <Border.Resources>
    <Style TargetType="ButtonBase" x:Key="Pill">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
        <Border x:Name="Tile" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="Opacity" Value=".72"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource Pill}">
      <Setter Property="Padding" Value="5,6"/><Setter Property="Margin" Value="1"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="8,18,0,4"/></Style>
    <DataTemplate x:Key="Welcome">
      <Border CornerRadius="14" Background="{DynamicResource Surface}" TextElement.Foreground="{DynamicResource Ink}" Margin="0,0,0,12">
        <Grid>
          <Border Width="3" Background="{DynamicResource Accent}" Margin="0,20,0,20" CornerRadius="1.5" HorizontalAlignment="Left"/>
          <StackPanel Margin="20">
            <TextBlock Text="欢迎使用如许AI" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="GuideHint" Text="三步开始阅读" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,4" TextWrapping="Wrap"/>
            <WrapPanel x:Name="Steps"/>
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="Connect" Content="连接模型 API" Style="{StaticResource Pill}" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" Margin="0,0,8,0"/>
              <Button x:Name="LearnKeys" Content="了解快捷键 ›" Style="{StaticResource Pill}"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="EmptyHistory">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Ink}" Margin="0,12">
        <ContentControl x:Name="HistoryIcon" HorizontalAlignment="Center" Focusable="False" IsTabStop="False"/>
        <TextBlock Text="还没有阅读记录" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock x:Name="KeyHint" Text="在任意窗口按下" Foreground="{DynamicResource Muted}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,4,0,8"/>
        <StackPanel x:Name="KeyRows" HorizontalAlignment="Center"/>
        <Button x:Name="TryRegion" Content="现在试试框选" Style="{StaticResource Pill}" Background="{DynamicResource Soft}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Border.Resources>
  <DockPanel Margin="12,10">
    <Button x:Name="Settings" DockPanel.Dock="Bottom" Style="{StaticResource Pill}" AutomationProperties.Name="设置"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="8,4,0,12">
          <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource Accent}">
            <Path Data="M2,4 Q7,3 11,6 L11,18 Q7,15 2,16 Z M14,6 Q18,3 23,4 L23,16 Q18,15 14,18 Z"
                  Fill="{DynamicResource OnAccent}" Stretch="Uniform" Width="20" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="如许AI" FontWeight="SemiBold" FontSize="18" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="Region" Style="{StaticResource Pill}" ToolTip="框选解释 · Ctrl + Alt + Q"/>
        <Button x:Name="Article" Style="{StaticResource Pill}" ToolTip="提取整篇正文"/>
        <Button x:Name="LongImage" Style="{StaticResource Pill}" ToolTip="手动向下滚动采集"/>
        <Border Background="{DynamicResource Line}" Height="1" Margin="8,8"/>
        <Button x:Name="History" Style="{StaticResource Pill}"/>
        <TextBlock Margin="8,16,0,0" Text="当前偏好" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Margin="8,8,0,4" Foreground="{DynamicResource Muted}" FontSize="12.5" Text="阅读模式"/>
        <UniformGrid x:Name="Profiles" Columns="2"/>
        <TextBlock Style="{StaticResource Caption}" Text="回答速度"/>
        <UniformGrid Columns="2"><RadioButton x:Name="Normal" Content="标准" GroupName="Speed" Style="{StaticResource Chip}"/>
          <RadioButton x:Name="Fast" Content="快速" GroupName="Speed" Style="{StaticResource Chip}"/></UniformGrid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Border>
