<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Border Background="Transparent"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Border Background="Transparent" SnapsToDevicePixels="True">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="before" Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="thumb" MinHeight="16" MinWidth="0">
            <Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border x:Name="grip" CornerRadius="4" Background="{DynamicResource ScrollLine}"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="grip" Property="Background" Value="{DynamicResource ScrollMuted}"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="grip" Property="Background" Value="{DynamicResource ScrollMuted}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="after" Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
        </Track>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
        <Setter TargetName="before" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
        <Setter TargetName="after" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
        <Setter TargetName="thumb" Property="MinHeight" Value="0"/>
        <Setter TargetName="thumb" Property="MinWidth" Value="16"/>
      </Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/>
    </Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
