<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextElement.FontSize="14"
      TextElement.Foreground="{DynamicResource InkBrush}" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,11"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Opacity" Value=".78"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource ActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="box" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PreviewChoice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid>
        <Border x:Name="card" Background="{DynamicResource SurfaceBrush}" BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="14" Padding="6"><ContentPresenter/></Border>
        <Border x:Name="check" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource PrimaryBrush}">
          <TextBlock Text="✓" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/></Border>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="card" Property="Background" Value="{DynamicResource ActiveBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
      <Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="ring" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="4">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="track" Width="36" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource MutedBrush}" Background="{DynamicResource SurfaceBrush}">
              <Border x:Name="knob" CornerRadius="7" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Background="{DynamicResource MutedBrush}"/>
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="knob" Property="Background" Value="{DynamicResource PrimaryTextBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SliderPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{TemplateBinding Background}"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SizeSlider" TargetType="Slider">
      <Setter Property="MinHeight" Value="32"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Border x:Name="sliderFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="8" Padding="4,0" Background="Transparent">
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderPage}" Background="{DynamicResource PrimaryBrush}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="16" Height="16" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border CornerRadius="8" Background="{DynamicResource PrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource InkBrush}"/>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderPage}" Background="{DynamicResource MutedBrush}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
        </Track></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="sliderFocus" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Option" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="13,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="frame" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,9,0" TextElement.Foreground="{TemplateBinding Foreground}"/>
            <Border x:Name="marker" Grid.Column="1" Width="19" Height="19" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
              <Path x:Name="tick" Visibility="Hidden" Width="10" Height="7" Data="M1,4 L4,7 L10,1" Stretch="Fill" StrokeThickness="1.8"
                  Stroke="{DynamicResource PrimaryTextBrush}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="marker" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter TargetName="marker" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Opacity" Value=".78"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Headline" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Detail" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,21,0,7"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="InputFrame" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="14,9"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="MinHeight" Value="42"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="ThinkingOption" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="item" CornerRadius="10" Background="Transparent" Padding="12,8">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource ActiveBrush}"/><Setter Property="Foreground" Value="{DynamicResource ActiveTextBrush}"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource ActiveBrush}"/><Setter Property="Foreground" Value="{DynamicResource ActiveTextBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ThinkingOption}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" ClickMode="Press"
              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="frame" Background="{DynamicResource ActionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Grid IsHitTestVisible="False" Margin="12,0">
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                Margin="0,0,22,0" VerticalAlignment="Center"/>
            <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Border x:Name="keyboardFocus" IsHitTestVisible="False" Visibility="Collapsed" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" CornerRadius="14"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="4"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="keyboardFocus" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="MinWidth" Value="78"/><Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="18,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ActionBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="shape" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="20" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shape" Property="Opacity" Value=".87"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="shape" Property="Opacity" Value=".73"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="shape" Property="Opacity" Value=".54"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="shape" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="shape" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="Rail" Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,29">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="7,0,0,32">
        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Width="35" Height="35">
          <Path Data="M2,4 Q7,3 11,6 L11,18 Q7,15 2,16 Z M14,6 Q18,3 23,4 L23,16 Q18,15 14,18 Z"
                Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform" Width="22" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="如许AI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>
      <RadioButton x:Name="ReadingNav" GroupName="Page" Style="{StaticResource Nav}" Content="阅读选项"/>
      <RadioButton x:Name="AnswerNav" GroupName="Page" Style="{StaticResource Nav}" Content="回答偏好"/>
      <RadioButton x:Name="ShortcutsNav" GroupName="Page" Style="{StaticResource Nav}" Content="快捷键"/>
      <RadioButton x:Name="AppearanceNav" GroupName="Page" Style="{StaticResource Nav}" Content="外观"/>
      <RadioButton x:Name="ConnectionNav" GroupName="Page" Style="{StaticResource Nav}" Content="模型 API"/>
      <RadioButton x:Name="AboutNav" GroupName="Page" Style="{StaticResource Nav}" Content="关于"/>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,8,4,14"/>
      <Button x:Name="History" Style="{StaticResource Action}" Content="阅读记录"/>
    </StackPanel>
    </ScrollViewer>
  </Border>
  <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="CompactNav" Visibility="Collapsed" Background="{DynamicResource SideBrush}" Padding="8,5">
      <WrapPanel>
        <RadioButton x:Name="SmallReading" GroupName="SmallPage" Style="{StaticResource Nav}" Content="阅读选项" Padding="9,6" Margin="1"/>
        <RadioButton x:Name="SmallAnswer" GroupName="SmallPage" Style="{StaticResource Nav}" Content="回答偏好" Padding="9,6" Margin="1"/>
        <RadioButton x:Name="SmallShortcuts" GroupName="SmallPage" Style="{StaticResource Nav}" Content="快捷键" Padding="9,6" Margin="1"/>
        <RadioButton x:Name="SmallAppearance" GroupName="SmallPage" Style="{StaticResource Nav}" Content="外观" Padding="9,6" Margin="1"/>
        <RadioButton x:Name="SmallConnection" GroupName="SmallPage" Style="{StaticResource Nav}" Content="模型 API" Padding="9,6" Margin="1"/>
        <RadioButton x:Name="SmallAbout" GroupName="SmallPage" Style="{StaticResource Nav}" Content="关于" Padding="9,6" Margin="1"/>
        <Button x:Name="SmallHistory" Style="{StaticResource Action}" Content="阅读记录" MinHeight="30" Padding="9,6" Margin="1"/>
      </WrapPanel>
    </Border>
    <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel x:Name="PageInsets" Margin="32,24,32,24">
        <Button x:Name="Back" Content="← 返回" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <StackPanel x:Name="ConnectionPage">
          <TextBlock Text="模型 API" Style="{StaticResource Headline}"/>
          <TextBlock Text="使用兼容 Chat Completions 的模型服务。" Style="{StaticResource Detail}" Margin="0,7,0,4"/>
          <TextBlock Text="服务商" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="Provider" AutomationProperties.Name="服务商预设" MinHeight="40"/>
          <Button x:Name="KeyLink" Style="{StaticResource Action}" Content="获取 API Key ›" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          <TextBlock Text="API 地址" Style="{StaticResource Caption}"/>
          <Border x:Name="AddressFrame" Style="{StaticResource InputFrame}"><Grid>
            <TextBlock x:Name="AddressHint" Text="https://你的服务地址/v1" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="Address" AutomationProperties.Name="API 地址"/>
          </Grid></Border>
          <TextBlock x:Name="AddressIssue" Style="{StaticResource Detail}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
          <TextBlock Text="模型名称" Style="{StaticResource Caption}"/>
          <Border x:Name="ModelFrame" Style="{StaticResource InputFrame}"><Grid>
            <TextBlock x:Name="ModelHint" Text="服务商提供的模型 ID" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="Model" AutomationProperties.Name="模型名称"/>
          </Grid></Border>
          <TextBlock x:Name="ModelIssue" Style="{StaticResource Detail}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
          <TextBlock Text="API Key" Style="{StaticResource Caption}"/>
          <Border x:Name="KeyFrame" Style="{StaticResource InputFrame}"><Grid>
            <TextBlock Margin="0,0,42,0" x:Name="KeyHint" Text="输入密钥，本地免密服务可留空" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
            <PasswordBox Foreground="{DynamicResource InkBrush}" x:Name="Key" Margin="0,0,42,0" AutomationProperties.Name="API Key" FontSize="15" VerticalContentAlignment="Center" BorderThickness="0" Padding="0" Background="Transparent"/>
            <TextBox x:Name="ClearKey" Margin="0,0,42,0" IsUndoEnabled="False" AutomationProperties.Name="可见的 API Key" Visibility="Collapsed"/>
            <Button x:Name="RevealKey" HorizontalAlignment="Right" Style="{StaticResource Action}" Padding="5,2" MinWidth="32" MinHeight="32" AutomationProperties.Name="显示密钥" ToolTip="显示密钥">
              <Grid Width="18" Height="16"><Path Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Stretch="Uniform" Data="M1,8 Q8,-2 15,8 Q8,18 1,8 Z M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8"/>
                <Path x:Name="EyeSlash" Visibility="Collapsed" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Data="M1,1 L17,15"/>
              </Grid>
            </Button>
          </Grid></Border>
          <TextBlock Text="密钥由当前 Windows 账户加密保存。阅读内容会发送到上面的 API 地址。" Style="{StaticResource Detail}" Margin="0,14,0,0"/>
        </StackPanel>
        <StackPanel x:Name="ReadingPage" Visibility="Collapsed">
          <TextBlock Text="阅读选项" Style="{StaticResource Headline}"/>
          <TextBlock Text="回答速度" Style="{StaticResource Caption}"/>
          <Border Style="{StaticResource InputFrame}" Padding="12">
            <StackPanel>
              <WrapPanel AutomationProperties.Name="回答速度">
                <RadioButton x:Name="StandardReply" GroupName="ReplySpeed" Style="{StaticResource Choice}" Content="标准"/>
                <RadioButton x:Name="FastReply" GroupName="ReplySpeed" Style="{StaticResource Choice}" Content="快速"/>
              </WrapPanel>
              <TextBlock x:Name="SpeedDescription" Style="{StaticResource Detail}" Margin="5,3,5,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="文献阅读模式" Style="{StaticResource Caption}"/>
          <Border Style="{StaticResource InputFrame}" Padding="12,12,12,14">
            <StackPanel>
              <WrapPanel x:Name="Profiles" AutomationProperties.Name="文献阅读模式"/>
              <TextBlock x:Name="ProfileDescription" Style="{StaticResource Detail}" Margin="5,3,5,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="读取整篇时" Style="{StaticResource Caption}"/>
          <Border Style="{StaticResource InputFrame}" Padding="4">
            <StackPanel>
              <RadioButton x:Name="ArticleText" GroupName="ArticleCapture" Style="{StaticResource Option}" AutomationProperties.Name="提取正文">
                <StackPanel><TextBlock Text="提取正文" FontWeight="SemiBold"/><TextBlock Text="长文先速览，再按需逐段解读。每段约 4,000 tokens。" Style="{StaticResource Detail}" Margin="0,2,0,0"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ArticleImage" GroupName="ArticleCapture" Style="{StaticResource Option}" AutomationProperties.Name="滚轮长截图">
                <StackPanel><TextBlock Text="滚轮长截图" FontWeight="SemiBold"/><TextBlock Text="框选正文后向下滚，按 Enter 或 Ctrl + Alt + E 完成，Esc 取消。单次最多 8 屏，高分辨率下可能先达到图像上限。" Style="{StaticResource Detail}" Margin="0,2,0,0"/></StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <TextBlock Text="框选内容" Style="{StaticResource Caption}"/>
          <Border Style="{StaticResource InputFrame}" Padding="4">
            <StackPanel>
              <RadioButton x:Name="UseImage" GroupName="Capture" Style="{StaticResource Option}" AutomationProperties.Name="发送原图">
                <StackPanel><TextBlock Text="发送原图" FontWeight="SemiBold"/><TextBlock Text="适合支持读图的模型，可解释公式和图表。" Style="{StaticResource Detail}" Margin="0,3,0,0"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="UseText" GroupName="Capture" Style="{StaticResource Option}" AutomationProperties.Name="本机识字">
                <StackPanel><TextBlock Text="本机识字" FontWeight="SemiBold"/><TextBlock Text="由 Windows 提取截图里的文字，适合纯文本模型。" Style="{StaticResource Detail}" Margin="0,3,0,0"/></StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <TextBlock Text="思考模式" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="Thinking" AutomationProperties.Name="思考模式" MinHeight="40" Padding="11,7" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
          <TextBlock Text="想更快看到回答，可按服务商文档选择对应的关闭思考选项。" Style="{StaticResource Detail}" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel x:Name="AnswerPage" Visibility="Collapsed">
          <TextBlock Text="回答偏好" Style="{StaticResource Headline}"/>
          <TextBlock Text="你希望 AI 怎样解释？这里的偏好会用于首次解释和后续追问。" Style="{StaticResource Detail}" Margin="0,7,0,4"/>
          <TextBlock Text="自定义提示词" Style="{StaticResource Caption}"/>
          <Border Style="{StaticResource InputFrame}" Padding="12">
            <Grid>
              <TextBlock x:Name="PromptHint" Text="例如，先说结论，遇到公式时逐个解释符号。" Style="{StaticResource Detail}" IsHitTestVisible="False"/>
              <TextBox x:Name="Prompt" AutomationProperties.Name="自定义提示词" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinLines="6" MaxLines="12" VerticalScrollBarVisibility="Auto"/>
            </Grid>
          </Border>
          <Button x:Name="ClearPrompt" Style="{StaticResource Action}" Content="清空提示词" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          <TextBlock Text="留空后，回答将遵循所选的文献阅读模式。" Style="{StaticResource Detail}" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed">
          <TextBlock Text="快捷键" Style="{StaticResource Headline}"/>
          <TextBlock Text="选择一项后按下组合键。Esc 取消，Backspace 清空。" Style="{StaticResource Detail}" Margin="0,8,0,16"/>
          <StackPanel x:Name="ShortcutRows"/>
          <TextBlock x:Name="ShortcutMessage" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
          <TextBlock Text="外观" Style="{StaticResource Headline}"/>
          <TextBlock Text="选择后立即应用到所有窗口。跟随系统会随 Windows 应用主题自动切换。" Style="{StaticResource Detail}" Margin="0,7,0,18"/>
          <WrapPanel Margin="0,0,0,16">
            <RadioButton x:Name="SystemMode" GroupName="AppearanceMode" Style="{StaticResource PreviewChoice}" AutomationProperties.Name="跟随系统"><StackPanel><Grid Width="80" Height="56">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource LightPreview}" CornerRadius="6,0,0,6"/>
              <Border Grid.Column="1" Background="{DynamicResource DarkPreview}" CornerRadius="0,6,6,0"/>
              <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" CornerRadius="6"/>
              <Border Grid.ColumnSpan="2" VerticalAlignment="Top" Height="1" Background="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
              <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="3" Width="24" Background="{DynamicResource MutedBrush}" Margin="9,9,0,0"/>
            </Grid><TextBlock Text="跟随系统" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
            <RadioButton x:Name="LightMode" GroupName="AppearanceMode" Style="{StaticResource PreviewChoice}" AutomationProperties.Name="浅色"><StackPanel><Grid Width="80" Height="56">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource LightPreview}" CornerRadius="6,0,0,6"/>
              <Border Grid.Column="1" Background="{DynamicResource LightPreview}" CornerRadius="0,6,6,0"/>
              <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" CornerRadius="6"/>
              <Border Grid.ColumnSpan="2" VerticalAlignment="Top" Height="1" Background="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
              <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="3" Width="24" Background="{DynamicResource MutedBrush}" Margin="9,9,0,0"/>
            </Grid><TextBlock Text="浅色" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
            <RadioButton x:Name="DarkMode" GroupName="AppearanceMode" Style="{StaticResource PreviewChoice}" AutomationProperties.Name="深色"><StackPanel><Grid Width="80" Height="56">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource DarkPreview}" CornerRadius="6,0,0,6"/>
              <Border Grid.Column="1" Background="{DynamicResource DarkPreview}" CornerRadius="0,6,6,0"/>
              <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" CornerRadius="6"/>
              <Border Grid.ColumnSpan="2" VerticalAlignment="Top" Height="1" Background="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
              <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="3" Width="24" Background="{DynamicResource MutedBrush}" Margin="9,9,0,0"/>
            </Grid><TextBlock Text="深色" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
          </WrapPanel>
          <TextBlock Text="回答字号" Style="{StaticResource Caption}"/>
          <DockPanel><TextBlock x:Name="SizeValue" DockPanel.Dock="Right" MinWidth="48" TextAlignment="Right"/>
            <Slider x:Name="AnswerSize" Style="{StaticResource SizeSlider}" AutomationProperties.Name="回答字号" Minimum="10" Maximum="18" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/></DockPanel>
        </StackPanel>
        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
          <TextBlock Text="关于如许AI" Style="{StaticResource Headline}"/>
          <TextBlock x:Name="Version" Style="{StaticResource Detail}" Margin="0,8,0,16"/>
          <CheckBox x:Name="Startup" Style="{StaticResource Switch}" Content="登录 Windows 时自动启动"/>
          <TextBlock Text="开源许可证" Style="{StaticResource Caption}"/>
          <WrapPanel x:Name="Licenses"/>
          <TextBox x:Name="LicenseText" Visibility="Collapsed" IsReadOnly="True" AutomationProperties.Name="许可证全文" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SideBrush}" Padding="22,13">
      <StackPanel>
        <TextBlock x:Name="Error" Visibility="Collapsed" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <WrapPanel x:Name="ConnectionActions" HorizontalAlignment="Left">
          <Button x:Name="Test" Style="{StaticResource Action}" Content="测试连接" ToolTip="发送一条极短请求，服务商可能按用量计费"/>
          <Button x:Name="Save" Style="{StaticResource Action}" Content="保存" FontWeight="SemiBold" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,0"/>
        </WrapPanel>
        <TextBlock x:Name="Feedback" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
